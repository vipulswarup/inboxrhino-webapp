# Firebase (public client config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Turnstile (public site key)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google Analytics (optional override; production defaults to G-JWMSV0FTTY)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Ahrefs Web Analytics (optional override; production defaults to the InboxRhino project key)
NEXT_PUBLIC_AHREFS_ANALYTICS_KEY=

# API (local Worker URL when running dev:worker)
NEXT_PUBLIC_INBOXRHINO_API_URL=http://127.0.0.1:8787
