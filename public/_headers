# Cloudflare serves public/ before the Worker runs, so middleware.ts never sees
# these paths. Keep these rules in sync with robotsHeaderValue() and
# isCacheablePublicAsset() in app/lib/seo.ts.
# vinext only generates its own _headers when this file is absent, so its
# immutable rule for hashed assets is repeated here.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/openapi.yaml
  X-Robots-Tag: noindex, follow

/postman/*
  X-Robots-Tag: noindex, follow

/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
