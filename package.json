{
  "name": "inboxrhino-webapp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:worker": "WRANGLER_LOG_PATH=.wrangler/logs wrangler dev --config wrangler.backend.jsonc",
    "build": "vinext build",
    "build:worker": "WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy --dry-run --config wrangler.backend.jsonc --outdir dist-worker",
    "deploy:worker": "WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy --config wrangler.backend.jsonc --keep-vars",
    "check": "npm run lint && npm run typecheck && npm test && npm run build:worker",
    "release:worker": "npm run check && npm run db:migrate:remote && npm run deploy:worker",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate:local": "WRANGLER_LOG_PATH=.wrangler/logs wrangler d1 migrations apply inboxrhino-prod --local --config wrangler.backend.jsonc",
    "db:migrate:remote": "WRANGLER_LOG_PATH=.wrangler/logs wrangler d1 migrations apply inboxrhino-prod --remote --config wrangler.backend.jsonc",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-worker --ignore-pattern .next --ignore-pattern .wrangler",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "deploy:web": "WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy --config dist/server/wrangler.json --keep-vars",
    "release:web": "npm run check && npm run build && npm run deploy:web"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "firebase": "^11.10.0",
    "hono": "^4.13.5",
    "next": "16.3.3",
    "postal-mime": "^3.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.0",
    "@cloudflare/workers-types": "5.20260826.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "js-yaml": "^5.4.1",
    "jsdom": "^26.1.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "vitest": "3.2.6",
    "wrangler": "4.126.0"
  },
  "type": "module"
}
